<script>
/* =========================================================
   EduTrack — School Nurse / Health Module
   ========================================================= */
var APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwxodIXTSyZlzdl8Uropf30mqXC_Ea4XaKlpbtvdrhF5VxEtTeeUj4lz7tkbsWex3XWIw/exec';
var ACCOUNTS_SHEET_ID = '1OmV8zDm_KfwdHs3KQcvdpeIiJimLUa3KxltXcPcZjaQ';
var CLASSES = ['S.1','S.2','S.3','S.4','S.5','S.6'];
var HEALTH_CATEGORIES = ['headache','stomach','fever','cough','injury','diarrhea','vomiting','allergy','menstrual','dental','eye','ear','skin','general','followup','other'];

/* ========== STATE ========== */
var authSession = null;
var nurseInfo = null;
var currentTab = 'dashboard';
var scanPurpose = null;
var html5QrScanner = null;
var studentsCache = [];
var staffCache = [];
var visitsCache = [];
var firstAidCache = [];
var referralsCache = [];
var incidentsCache = [];
var medsAdminCache = [];
var inventoryCache = [];
var screeningsCache = [];
var campaignsCache = [];
var handoversCache = [];
var notificationsCache = [];
var offlineQueue = [];
var selectedPerson = null;
var chartInstances = {};

/* ========== UTILITIES ========== */
function today(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function nowIso(){ return new Date().toISOString(); }
function nowTime(){ return new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}); }
function genId(prefix){ return (prefix||'ID')+'-'+Date.now().toString(36).toUpperCase()+'-'+Math.floor(Math.random()*1000); }
function escapeHtml(v){ return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function getActiveSchool(){ return authSession ? authSession.school : ''; }
function getClassSheetId(cls){ return localStorage.getItem('classLink_'+cls+'_'+getActiveSchool()) || ''; }
function shortTime(ts){ try{ var d=new Date(ts); return d.toLocaleDateString()+' '+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}); }catch(e){ return ts; } }

function showToast(msg, type){
  type = type||'info';
  var t = document.createElement('div');
  t.className = 'toast-notification '+type;
  t.textContent = msg;
  document.getElementById('toastContainer').appendChild(t);
  setTimeout(function(){ t.classList.add('show'); }, 20);
  setTimeout(function(){ t.classList.remove('show'); setTimeout(function(){ t.remove(); }, 400); }, 3500);
}
function showLoading(v){ document.getElementById('loadingOverlay').classList.toggle('active', v); }
function toggleMobileMenu(){ document.getElementById('navbarMenu').classList.toggle('open'); }

var _confirmResolve = null;
function confirmAction(title, msg, yesLabel, icon){
  return new Promise(function(resolve){
    _confirmResolve = resolve;
    document.getElementById('confirmIcon').textContent = icon||'⚠️';
    document.getElementById('confirmTitle').textContent = title||'Confirm';
    document.getElementById('confirmMessage').textContent = msg||'Are you sure?';
    document.getElementById('confirmYesBtn').textContent = yesLabel||'Yes';
    document.getElementById('confirmYesBtn').onclick = function(){ closeConfirm(true); };
    document.getElementById('confirmModal').classList.add('active');
  });
}
function closeConfirm(yes){
  document.getElementById('confirmModal').classList.remove('active');
  if(_confirmResolve){ _confirmResolve(yes); _confirmResolve = null; }
}
function openInfoModal(html, title, actions){
  document.getElementById('infoModalTitle').textContent = title||'Details';
  document.getElementById('infoModalBody').innerHTML = html;
  document.getElementById('infoModalActions').innerHTML = actions || '<button class="btn btn-secondary" onclick="closeInfoModal()">Close</button>';
  document.getElementById('infoModal').classList.add('active');
}
function closeInfoModal(){ document.getElementById('infoModal').classList.remove('active'); }

/* ========== API ========== */
async function api(params){
  if(APPS_SCRIPT_URL.indexOf('YOUR_DEPLOYMENT_ID_HERE')!==-1) throw new Error('Update APPS_SCRIPT_URL');
  var parts=[];
  for(var k in params) if(params.hasOwnProperty(k) && params[k]!=null){
    parts.push(encodeURIComponent(k)+'='+encodeURIComponent(params[k]));
  }
  try{
    var res = await fetch(APPS_SCRIPT_URL, {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'},
      body: parts.join('&'),
      signal: AbortSignal.timeout(20000)
    });
    if(!res.ok) throw new Error('HTTP '+res.status);
    return await res.json();
  } catch(e){
    console.warn('[api offline]', e.message);
    return {success:false, offline:true};
  }
}

/* ========== AUDIT ========== */
async function audit(action, recordType, recordId, details){
  var entry = {
    timestamp: nowIso(),
    user: authSession?.username || 'unknown',
    userName: authSession?.name || '',
    role: 'nurse',
    action: action,
    recordType: recordType,
    recordId: recordId||'',
    details: details||'',
    device: navigator.userAgent.substring(0,80),
    school: getActiveSchool()
  };
  await api({action:'logHealthAudit', sheetId: ACCOUNTS_SHEET_ID, school: getActiveSchool(), entry: JSON.stringify(entry)});
  var local = JSON.parse(localStorage.getItem('health_audit_'+getActiveSchool())||'[]');
  local.push(entry);
  if(local.length > 2000) local = local.slice(-1500);
  localStorage.setItem('health_audit_'+getActiveSchool(), JSON.stringify(local));
}

/* ========== OFFLINE QUEUE ========== */
function queueOffline(action, payload){
  offlineQueue.push({id:genId('Q'), action:action, payload:payload, timestamp:nowIso()});
  localStorage.setItem('health_queue_'+getActiveSchool(), JSON.stringify(offlineQueue));
  updateSyncBadge();
}
function loadOfflineQueue(){
  try{ offlineQueue = JSON.parse(localStorage.getItem('health_queue_'+getActiveSchool())||'[]'); } catch(e){ offlineQueue = []; }
  updateSyncBadge();
}
function updateSyncBadge(){
  var badge = document.getElementById('syncBadge');
  var count = document.getElementById('syncCount');
  if(offlineQueue.length > 0){
    badge.classList.remove('hidden');
    count.textContent = offlineQueue.length;
  } else badge.classList.add('hidden');
}
async function syncOfflineQueue(){
  if(offlineQueue.length === 0){ showToast('✅ All synced','success'); return; }
  showLoading(true);
  var remaining = [];
  for(var i=0;i<offlineQueue.length;i++){
    var item = offlineQueue[i];
    try{
      var params = Object.assign({}, item.payload);
      params.action = item.action;
      var r = await api(params);
      if(r && (r.success || r.data)) continue;
      remaining.push(item);
    } catch(e){ remaining.push(item); }
  }
  offlineQueue = remaining;
  localStorage.setItem('health_queue_'+getActiveSchool(), JSON.stringify(offlineQueue));
  updateSyncBadge();
  showLoading(false);
  if(offlineQueue.length === 0) showToast('✅ All synced','success');
  else showToast('⚠️ '+offlineQueue.length+' still pending','warning');
}

