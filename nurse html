    return '<tr><td>'+escapeHtml(v.date+' '+(v.time||''))+'</td><td>'+escapeHtml(v.patientName||'')+'</td><td>'+escapeHtml(v.reason||'')+'</td><td>'+escapeHtml(v.outcome||'')+'</td></tr>';
