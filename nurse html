function startQrScanner(){
  if(typeof Html5Qrcode === 'undefined') return;
  html5QrScanner = new Html5Qrcode('qr-reader');
  html5QrScanner.start(
    {facingMode:'environment'},
    {fps:10, qrbox:{width:250,height:250}},
    function(text){
      var parts = text.split(':');
      var id = parts[1] || parts[0];
      closeScanner();
      switchTab('studenthealth');
      setTimeout(function(){ openStudentHealth(id); }, 200);
    },
    function(){}
  ).catch(function(err){ console.warn(err); });
}
function closeScanner(){
  document.getElementById('scannerModal').classList.remove('active');
  if(html5QrScanner){ html5QrScanner.stop().then(function(){ html5QrScanner.clear(); html5QrScanner = null; }).catch(function(){}); }
}
function switchCamera(){
  if(html5QrScanner){
    html5QrScanner.stop().then(function(){ closeScanner(); setTimeout(openStudentScanner, 300); }).catch(function(){});
  }
}

/* =========================================================
   TAB SWITCHING
   ========================================================= */
function switchTab(tab){
  currentTab = tab;
  document.querySelectorAll('.form-section').forEach(function(el){ el.classList.remove('active'); });
  var map = {
    dashboard:'tabDashboard', studenthealth:'tabStudenthealth', staffhealth:'tabStaffhealth',
    register:'tabRegister', newvisit:'tabNewvisit', firstaid:'tabFirstaid',
    medication:'tabMedication', inventory:'tabInventory', referrals:'tabReferrals',
    followups:'tabFollowups', screening:'tabScreening', campaigns:'tabCampaigns',
    incidents:'tabIncidents', parentnotif:'tabParentnotif', reports:'tabReports',
    handover:'tabHandover', notifications:'tabNotifications', emergency:'tabEmergency',
    profile:'tabProfile'
  };
  var el = document.getElementById(map[tab]);
  if(el) el.classList.add('active');
  document.querySelectorAll('.nav-link').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-tab')===tab);
  });
  document.querySelectorAll('.bn-item').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-tab')===tab);
  });
  document.getElementById('navbarMenu').classList.remove('open');
  window.scrollTo(0,0);

  if(tab==='dashboard') updateDashboard();
  if(tab==='register') renderRegister();
  if(tab==='firstaid') renderFirstAid();
  if(tab==='referrals') renderReferrals();
  if(tab==='followups') renderFollowups();
  if(tab==='incidents') renderHealthIncidents();
  if(tab==='parentnotif') loadPNHistory();
  if(tab==='handover') { renderHandovers(); updateHandoverSummary(); }
  if(tab==='emergency') loadEmergencyAlerts();
  if(tab==='inventory') renderInventory();
  if(tab==='notifications') renderNotifications();
  if(tab==='profile') updateProfile();
  if(tab==='reports') { /* handled on click */ }
}
function updateHandoverSummary(){
