  document.getElementById('hoInClinic').textContent = visitsCache.filter(function(v){ return v.date===todayStr && ['resting','observed'].indexOf(v.outcome)!==-1; }).length;
  document.getElementById('hoFollowUps').textContent = visitsCache.filter(function(v){ return v.followUpDate && v.followUpDate >= todayStr; }).length;
  document.getElementById('hoMedsDue').textContent = countMedsDueToday();
