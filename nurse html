async function generateHealthReport(){
  var type = document.getElementById('rpType').value;
  var period = document.getElementById('rpPeriod').value;
  var from, to;
  if(period==='today'){ from = today(); to = today(); }
  else if(period==='week'){ var d=new Date(); d.setDate(d.getDate()-7); from = d.toISOString().split('T')[0]; to = today(); }
  else if(period==='month'){ var d2=new Date(); d2.setDate(1); from = d2.toISOString().split('T')[0]; to = today(); }
  else { from = document.getElementById('rpFrom').value; to = document.getElementById('rpTo').value; }
  var out = document.getElementById('healthReportOutput');
  out.innerHTML = '<div style="text-align:center;padding:20px"><div class="spinner"></div></div>';
  var html = '';
  if(type==='daily' || type==='weekly' || type==='monthly'){
    var list = visitsCache.filter(function(v){ return v.date >= from && v.date <= to; });
    html = '<h3>Clinic Report ('+from+' to '+to+')</h3>'+
      '<div class="stats-grid">'+
        '<div class="stat-card"><div class="stat-number">'+list.filter(function(v){ return v.patientType==='student'; }).length+'</div><div class="stat-label">Student Visits</div></div>'+
        '<div class="stat-card"><div class="stat-number">'+list.filter(function(v){ return v.patientType==='staff'; }).length+'</div><div class="stat-label">Staff Visits</div></div>'+
        '<div class="stat-card"><div class="stat-number">'+list.length+'</div><div class="stat-label">Total</div></div>'+
      '</div>'+
      renderTable(list, ['date','time','patientName','reason','outcome','nurseName'], ['Date','Time','Patient','Reason','Outcome','Nurse']);
  }
  else if(type==='firstaid'){
    var list = firstAidCache.filter(function(f){ return f.date >= from && f.date <= to; });
    html = '<h3>First Aid Report</h3>' + renderTable(list, ['date','patientName','injuryType','location','outcome'], ['Date','Patient','Injury','Location','Outcome']);
  }
  else if(type==='referrals'){
    var list = referralsCache.filter(function(r){ return r.date >= from && r.date <= to; });
    html = '<h3>Referral Report</h3>' + renderTable(list, ['date','patientName','facility','reason','status'], ['Date','Patient','Facility','Reason','Status']);
  }
  else if(type==='medication'){
    var list = medsAdminCache.filter(function(m){ return m.date >= from && m.date <= to; });
    html = '<h3>Medication Administration Report</h3>' + renderTable(list, ['date','time','patientName','medicine','dose','nurseName'], ['Date','Time','Patient','Medicine','Dose','Nurse']);
  }
  else if(type==='inventory'){
    html = '<h3>Inventory Report</h3>' + renderTable(inventoryCache, ['name','quantity','minimumLevel','expiryDate','storage'], ['Item','Qty','Min','Expiry','Storage']);
  }
  else if(type==='incidents'){
    var list = incidentsCache.filter(function(i){ return i.date >= from && i.date <= to; });
    html = '<h3>Health Incident Report</h3>' + renderTable(list, ['date','type','location','status'], ['Date','Type','Location','Status']);
  }
  else if(type==='followups'){
    var list = visitsCache.filter(function(v){ return v.followUpDate; });
    html = '<h3>Follow-up Report</h3>' + renderTable(list, ['followUpDate','patientName','reason','nurseName'], ['Date','Patient','Reason','Nurse']);
  }
  else if(type==='campaigns'){
    html = '<h3>Campaign Report</h3>' + renderTable(campaignsCache, ['date','title','target','participants'], ['Date','Activity','Target','Participants']);
  }
  else if(type==='screening'){
    html = '<h3>Screening Report</h3>' + renderTable(screeningsCache, ['date','type','target','participants'], ['Date','Type','Target','Participants']);
  }
  out.innerHTML = html;
}
function renderTable(list, keys, headers){
  if(list.length === 0) return '<div class="info-box"><div class="info-text">No records in this period.</div></div>';
  var h = '<div class="table-wrap"><table class="data-table"><thead><tr>';
  headers.forEach(function(hdr){ h += '<th>'+escapeHtml(hdr)+'</th>'; });
  h += '</tr></thead><tbody>';
  list.slice(0,200).forEach(function(item){
    h += '<tr>';
    keys.forEach(function(k){ h += '<td>'+escapeHtml(item[k]||'')+'</td>'; });
    h += '</tr>';
  });
  h += '</tbody></table></div>';
  return h;
}
