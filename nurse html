function showInvSub(sub){
  document.querySelectorAll('#tabInventory .tab-strip button').forEach(function(b,i){
    b.classList.toggle('active', (i===0 && sub==='list')||(i===1 && sub==='add')||(i===2 && sub==='use'));
  });
  document.getElementById('invSubList').style.display = sub==='list'?'block':'none';
  document.getElementById('invSubAdd').style.display = sub==='add'?'block':'none';
  document.getElementById('invSubUse').style.display = sub==='use'?'block':'none';
