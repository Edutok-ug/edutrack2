  var item = {
    id: genId('INV'),
    name: name,
    category: document.getElementById('invAddCategory').value,
    quantity: qty,
    minimumLevel: parseFloat(document.getElementById('invAddMin').value)||5,
    expiryDate: document.getElementById('invAddExpiry').value,
    batch: document.getElementById('invAddBatch').value,
    storage: document.getElementById('invAddStorage').value,
    supplier: document.getElementById('invAddSupplier').value,
    timestamp: nowIso(),
    school: getActiveSchool()
  };
  try{
    var r = await api({action:'addInventory', sheetId: ACCOUNTS_SHEET_ID, school: getActiveSchool(), item: JSON.stringify(item)});
    if(r.offline) queueOffline('addInventory', {sheetId: ACCOUNTS_SHEET_ID, school: getActiveSchool(), item: JSON.stringify(item)});
    await audit('ADD_INVENTORY','inventory',item.id,name+' qty '+qty);
