  var staffVisits = todayVisits.filter(function(v){ return v.patientType === 'staff'; }).length;
  var inClinic = todayVisits.filter(function(v){ return ['resting','observed'].indexOf(v.outcome) !== -1; }).length;
  var followUps = visitsCache.filter(function(v){ return v.followUpDate && v.followUpDate >= todayStr && v.followUpStatus !== 'completed'; }).length;
  var medsDue = countMedsDueToday();
  var activeRefs = referralsCache.filter(function(r){ return ['referred','follow-up-required','attended'].indexOf(r.status) !== -1; }).length;
  var openInc = incidentsCache.filter(function(i){ return i.status === 'open' || i.status === 'review'; }).length;
