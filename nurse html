async function recordInventoryUsage(){
  var id = document.getElementById('invUseItem').value;
  var qty = parseFloat(document.getElementById('invUseQty').value)||0;
  if(!id || qty <= 0){ showToast('Fill fields','warning'); return; }
  var item = inventoryCache.filter(function(x){ return x.id===id; })[0];
  if(!item){ showToast('Item not found','error'); return; }
  var todayStr = today();
  if(item.expiryDate && item.expiryDate < todayStr){ showToast('❌ Cannot use expired item','error'); return; }
  if((parseFloat(item.quantity)||0) < qty){ showToast('❌ Insufficient stock','error'); return; }
  try{
    var r = await api({action:'recordInventoryUsage', sheetId: ACCOUNTS_SHEET_ID, school: getActiveSchool(), itemId: id, qty: qty, reason: document.getElementById('invUseReason').value, date: document.getElementById('invUseDate').value});
    await audit('INVENTORY_USAGE','inventory',id,qty+' of '+item.name);
    item.quantity = (parseFloat(item.quantity)||0) - qty;
    showToast('✅ Usage recorded','success');
    ['invUseQty','invUseReason'].forEach(function(id2){ document.getElementById(id2).value=''; });
    renderInventory();
  } catch(e){ showToast('❌ '+e.message,'error'); }
}

