<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<meta name="theme-color" content="#c1121f" />
<title>🏥 School Nurse — EduTrack Pro</title>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --bg1:#0f0c29;--bg2:#302b63;--bg3:#24243e;
  --primary:#302b63;--accent:#fcdc04;
  --health:#c1121f;--health-dark:#780000;--health-light:#f8d7da;
  --success:#1a8a4a;--success-dark:#2d6a4f;--danger:#c1121f;--danger-dark:#780000;
  --warning:#e85d04;--warning-dark:#dc2f02;--info:#004085;--info-light:#0069d9;
  --surface:#fff;--surface-2:#f8f9fa;--surface-3:#f0f4ff;
  --text:#1a1a2e;--text-2:#555;--text-3:#888;--border:#e0e0e0;
  --shadow-sm:0 2px 10px rgba(0,0,0,.06);
  --shadow-md:0 4px 15px rgba(0,0,0,.08);
  --shadow-lg:0 10px 30px rgba(0,0,0,.15);
  --radius-sm:8px;--radius-md:12px;--radius-lg:16px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:'Segoe UI',Tahoma,sans-serif;background:linear-gradient(135deg,var(--bg1),var(--bg2) 50%,var(--bg3));min-height:100vh;padding:10px;color:var(--text)}
@media(min-width:768px){body{padding:20px}}

.navbar{background:rgba(255,255,255,.98);border-radius:var(--radius-lg) var(--radius-lg) 0 0;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;box-shadow:var(--shadow-md);position:sticky;top:0;z-index:1000;border-bottom:3px solid var(--health)}
.navbar-brand{display:flex;align-items:center;gap:8px;font-size:20px;font-weight:700;color:var(--health);text-decoration:none;font-family:Georgia,serif}
.navbar-brand .brand-text{background:linear-gradient(135deg,var(--health-dark),var(--health));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.navbar-toggle{display:none;background:none;border:none;font-size:22px;color:var(--health);cursor:pointer;padding:6px}
@media(max-width:900px){.navbar-toggle{display:block}}
.navbar-menu{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
@media(max-width:900px){
  .navbar-menu{display:none;width:100%;flex-direction:column;align-items:stretch;padding:10px 0;border-top:1px solid var(--border);margin-top:10px;max-height:70vh;overflow-y:auto}
  .navbar-menu.open{display:flex}
}
.nav-link{padding:9px 13px;border-radius:10px;color:#666;font-weight:600;font-size:13px;cursor:pointer;background:none;border:none;display:flex;align-items:center;gap:6px;white-space:nowrap;text-align:left}
.nav-link:hover{background:rgba(193,18,31,.08);color:var(--health)}
.nav-link.active{background:linear-gradient(135deg,var(--health-dark),var(--health));color:#fff}
.nav-user{display:flex;align-items:center;gap:8px;padding:4px 10px;border-radius:20px;background:var(--health-light);border:1px solid var(--health)}
.nav-user .user-avatar{width:30px;height:30px;border-radius:50%;background:var(--health);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px}
.nav-user .user-info{font-size:11px;line-height:1.2}
.nav-user .user-info .user-name{font-weight:600}
.nav-user .user-info .user-role{font-size:9px;color:var(--text-3)}

.bottom-nav{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);padding:6px 0;z-index:900;box-shadow:0 -4px 15px rgba(0,0,0,.08)}
.bottom-nav .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px;border:none;background:none;font-size:10px;color:var(--text-3);cursor:pointer;font-weight:600}
.bottom-nav .bn-item.active{color:var(--health)}
.bottom-nav .bn-item i{font-size:18px}
@media(max-width:900px){.bottom-nav{display:flex}body{padding-bottom:70px}}

.container{max-width:1400px;margin:0 auto;background:rgba(255,255,255,.97);border-radius:0 0 var(--radius-lg) var(--radius-lg);padding:18px 15px 24px;box-shadow:0 20px 60px rgba(0,0,0,.4);min-height:80vh;position:relative}
@media(min-width:768px){.container{padding:22px 28px 32px}}
.container::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#000 0%,#000 33%,var(--accent) 33%,var(--accent) 66%,var(--health) 66%,var(--health) 100%)}

.form-section{display:none;animation:fadeIn .25s ease;padding-top:8px}
.form-section.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.section-title{font-size:20px;color:var(--text);margin-bottom:4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.section-desc{color:var(--text-3);font-size:13px;margin-bottom:16px}

.form-group{margin-bottom:14px}
.form-group label{display:block;font-weight:600;color:var(--text-2);font-size:13px;margin-bottom:5px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:12px 14px;border:2px solid var(--border);border-radius:10px;font-size:15px;background:#fafafa;font-family:inherit;-webkit-appearance:none}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--health);outline:none;box-shadow:0 0 0 3px rgba(193,18,31,.15);background:#fff}
.form-row-2{display:grid;grid-template-columns:1fr;gap:12px}
.form-row-3{display:grid;grid-template-columns:1fr;gap:12px}
@media(min-width:640px){.form-row-2{grid-template-columns:1fr 1fr}.form-row-3{grid-template-columns:1fr 1fr 1fr}}

.btn{padding:14px 22px;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:50px;transition:.15s}
.btn:active{transform:scale(.97)}
.btn-primary{background:linear-gradient(135deg,var(--health-dark),var(--health));color:#fff}
.btn-success{background:linear-gradient(135deg,var(--success),var(--success-dark));color:#fff}
.btn-danger{background:linear-gradient(135deg,var(--danger),var(--danger-dark));color:#fff}
.btn-warning{background:linear-gradient(135deg,var(--warning),var(--warning-dark));color:#fff}
.btn-info{background:linear-gradient(135deg,var(--info),var(--info-light));color:#fff}
.btn-secondary{background:#e2e8f0;color:#333}
.btn-sm{padding:8px 14px;font-size:12px;min-height:36px}
.btn-block{width:100%}
.btn-lg{min-height:60px;font-size:17px}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-group{display:grid;grid-template-columns:1fr 1fr;gap:10px}

.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}
@media(min-width:640px){.action-grid{grid-template-columns:repeat(4,1fr)}}
.action-btn{background:#fff;border:2px solid var(--border);border-radius:var(--radius-md);padding:20px 12px;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;font-weight:700;color:var(--text);font-size:13px;text-align:center;min-height:110px;transition:.15s;box-shadow:var(--shadow-sm)}
.action-btn:active{transform:scale(.96)}
.action-btn .ai{font-size:32px}
.action-btn.emergency{border-color:var(--danger);background:#fff5f5}

.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:14px 0}
@media(min-width:640px){.stats-grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:1024px){.stats-grid{grid-template-columns:repeat(4,1fr)}}
.stat-card{background:#fff;border-radius:var(--radius-md);padding:14px;box-shadow:var(--shadow-sm);border:1px solid var(--border);position:relative;overflow:hidden;text-align:center}
.stat-card::before{content:'';position:absolute;top:0;left:0;bottom:0;width:4px;background:var(--health)}
.stat-card.success::before{background:var(--success)}
.stat-card.danger::before{background:var(--danger)}
.stat-card.warning::before{background:var(--warning)}
.stat-card.info::before{background:var(--info)}
.stat-card .stat-icon{font-size:22px}
.stat-card .stat-number{font-size:22px;font-weight:700;color:var(--text);margin:4px 0;line-height:1.1}
.stat-card .stat-label{font-size:11px;color:var(--text-3);text-transform:uppercase;font-weight:600}

.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--radius-md);background:#fff;box-shadow:var(--shadow-sm);border:1px solid var(--border);margin:10px 0}
table.data-table{width:100%;border-collapse:collapse;font-size:13px;min-width:520px}
table.data-table th{background:linear-gradient(135deg,var(--health-dark),var(--health));color:#fff;padding:10px 8px;text-align:left;font-size:11px;text-transform:uppercase;position:sticky;top:0;z-index:2}
table.data-table td{padding:10px 8px;border-bottom:1px solid var(--border);vertical-align:top}
table.data-table tr:last-child td{border-bottom:none}
table.data-table tr:hover td{background:var(--surface-2)}
.badge{display:inline-block;padding:3px 9px;border-radius:12px;font-size:10px;font-weight:700;white-space:nowrap}
.badge-pending,.badge-due{background:#fff3cd;color:#856404}
.badge-approved,.badge-administered{background:#cce5ff;color:#004085}
.badge-active,.badge-resolved{background:#d4edda;color:#155724}
.badge-open,.badge-critical{background:#f8d7da;color:#721c24}
.badge-review,.badge-warning{background:#fff3cd;color:#856404}
.badge-info{background:#cce5ff;color:#004085}
.badge-completed{background:#d4edda;color:#155724}
.badge-missed{background:#f8d7da;color:#721c24}

.search-bar{position:relative;margin:10px 0}
.search-bar input{width:100%;padding:14px 14px 14px 44px;border:2px solid var(--border);border-radius:10px;font-size:16px;background:#fafafa}
.search-bar input:focus{border-color:var(--health);outline:none;background:#fff}
.search-bar::before{content:'🔍';position:absolute;left:15px;top:50%;transform:translateY(-50%);font-size:16px;opacity:.6}

.person-result{background:#fff;border:2px solid var(--border);border-radius:10px;padding:12px;margin-bottom:8px;cursor:pointer;display:flex;gap:12px;align-items:center}
.person-result:hover{border-color:var(--health);background:#fff5f5}
.person-result .pr-avatar{width:52px;height:52px;border-radius:50%;background:var(--health);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;overflow:hidden;flex-shrink:0}
.person-result .pr-avatar img{width:100%;height:100%;object-fit:cover}
.person-result .pr-info{flex:1;min-width:0}
.person-result .pr-name{font-weight:700;color:var(--text);font-size:14px}
.person-result .pr-meta{font-size:11px;color:var(--text-3);margin-top:2px}

.person-card{background:#fff;border:2px solid var(--health);border-radius:var(--radius-md);padding:18px;text-align:center;margin:10px 0}
.person-card .pc-photo{width:110px;height:110px;border-radius:50%;background:var(--health);color:#fff;display:flex;align-items:center;justify-content:center;font-size:44px;font-weight:700;margin:0 auto 12px;overflow:hidden}
.person-card .pc-photo img{width:100%;height:100%;object-fit:cover}
.person-card .pc-name{font-size:20px;font-weight:700;color:var(--text)}
.person-card .pc-meta{font-size:13px;color:var(--text-3);margin-top:4px}
.person-card .pc-status{display:inline-block;margin-top:10px;padding:6px 16px;border-radius:20px;font-weight:700;font-size:13px}

.medical-alert{background:#fff3cd;border-left:5px solid var(--warning);padding:12px;border-radius:8px;margin:8px 0;display:flex;gap:10px;align-items:flex-start}
.medical-alert.critical{background:#f8d7da;border-left-color:var(--danger)}
.medical-alert.info{background:#cce5ff;border-left-color:var(--info)}
.medical-alert .ma-icon{font-size:24px}
.medical-alert .ma-text{flex:1;font-size:13px;font-weight:600}
.medical-alert .ma-detail{font-size:11px;color:#666;margin-top:2px;font-weight:400}

.emergency-panel{background:linear-gradient(135deg,var(--danger),var(--danger-dark));color:#fff;padding:20px;border-radius:var(--radius-md);text-align:center;margin:14px 0}
.emergency-panel h3{color:#fff;font-size:22px;margin-bottom:8px}
.emergency-panel p{color:rgba(255,255,255,.9)}
.emergency-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.emergency-type{background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.3);color:#fff;padding:16px;border-radius:10px;font-weight:700;cursor:pointer;font-size:13px;min-height:64px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}
.emergency-type:active{background:rgba(255,255,255,.3)}

.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;display:none;align-items:center;justify-content:center;padding:15px}
.modal-overlay.active{display:flex}
.modal-box{background:#fff;border-radius:var(--radius-lg);padding:22px;max-width:600px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-lg)}
.modal-box h3{text-align:center;color:var(--text);margin-bottom:10px;font-size:18px}
.modal-box .modal-icon{font-size:44px;text-align:center;display:block;margin-bottom:8px}
.modal-box p{text-align:center;color:var(--text-2);margin-bottom:18px;font-size:14px}
.modal-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}

.toast-notification{position:fixed;top:16px;right:16px;left:16px;padding:14px 18px;border-radius:12px;color:#fff;font-weight:600;z-index:99999;opacity:0;transform:translateY(-20px);transition:all .3s;font-size:14px;box-shadow:var(--shadow-lg);text-align:center}
@media(min-width:640px){.toast-notification{left:auto;max-width:400px;text-align:left;transform:translateX(120%)}}
.toast-notification.show{opacity:1;transform:translateY(0)}
@media(min-width:640px){.toast-notification.show{transform:translateX(0)}}
.toast-notification.success{background:linear-gradient(135deg,var(--success),var(--success-dark))}
.toast-notification.error{background:linear-gradient(135deg,var(--danger),var(--danger-dark))}
.toast-notification.info{background:linear-gradient(135deg,var(--health-dark),var(--health))}
.toast-notification.warning{background:linear-gradient(135deg,var(--warning),var(--warning-dark))}

.info-box{background:var(--surface-3);border-left:4px solid var(--health);padding:12px 15px;border-radius:8px;margin:12px 0}
.info-box.warning{background:#fff3cd;border-left-color:var(--warning)}
.info-box.success{background:#d4edda;border-left-color:var(--success)}
.info-box.danger{background:#f8d7da;border-left-color:var(--danger)}
.info-box .info-title{font-weight:700;color:var(--health);font-size:13px;margin-bottom:3px}
.info-box .info-text{color:var(--text-2);font-size:12px;line-height:1.5}

.spinner{width:40px;height:40px;border:4px solid #f3f3f3;border-top:4px solid var(--health);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto}
@keyframes spin{100%{transform:rotate(360deg)}}
.loading-overlay{position:fixed;inset:0;background:rgba(255,255,255,.9);display:none;align-items:center;justify-content:center;z-index:9998}
.loading-overlay.active{display:flex}

.sync-badge{position:fixed;bottom:80px;right:16px;background:var(--warning);color:#fff;padding:8px 14px;border-radius:20px;font-size:12px;font-weight:700;z-index:800;box-shadow:var(--shadow-lg);cursor:pointer}
.sync-badge.hidden{display:none}

.chart-container{background:#fff;border-radius:var(--radius-md);padding:16px;box-shadow:var(--shadow-sm);border:1px solid var(--border);margin:14px 0}
.chart-container h4{font-size:14px;color:var(--health);margin-bottom:10px}
.chart-container canvas{max-height:260px;max-width:100%}

.privacy-banner{background:linear-gradient(135deg,#1a1a2e,#302b63);color:#fff;padding:10px 14px;border-radius:10px;margin:10px 0;font-size:12px;display:flex;align-items:center;gap:8px}
.privacy-banner i{font-size:16px;color:var(--accent)}

@media print{
  .navbar,.bottom-nav,.btn,.no-print,.footer{display:none!important}
  body{background:#fff!important;padding:0}
  .container{box-shadow:none!important}
  @page{size:A4;margin:10mm}
}
</style>
</head>
<body>

<div id="toastContainer"></div>
<div class="loading-overlay" id="loadingOverlay"><div class="spinner"></div></div>
<div class="sync-badge hidden" id="syncBadge" onclick="syncOfflineQueue()">☁️ <span id="syncCount">0</span> unsynced</div>

<!-- CONFIRM MODAL -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal-box">
    <span class="modal-icon" id="confirmIcon">⚠️</span>
    <h3 id="confirmTitle">Confirm</h3>
    <p id="confirmMessage">Are you sure?</p>
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="closeConfirm(false)">Cancel</button>
      <button class="btn btn-primary" id="confirmYesBtn">Yes</button>
    </div>
  </div>
</div>

<!-- INFO MODAL -->
<div class="modal-overlay" id="infoModal">
  <div class="modal-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <h3 style="margin:0;text-align:left" id="infoModalTitle">Details</h3>
      <button class="btn btn-secondary btn-sm" onclick="closeInfoModal()">✖</button>
    </div>
    <div id="infoModalBody"></div>
    <div class="modal-actions" style="margin-top:14px" id="infoModalActions"></div>
  </div>
</div>

<nav class="navbar">
  <a href="nurse.html" class="navbar-brand"><span style="font-size:26px">🏥</span><span class="brand-text">EduTrack Health</span></a>
  <button class="navbar-toggle" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="navbar-menu" id="navbarMenu">
    <button class="nav-link active" data-tab="dashboard" onclick="switchTab('dashboard')"><i class="fas fa-home"></i> Dashboard</button>
    <button class="nav-link" data-tab="studenthealth" onclick="switchTab('studenthealth')"><i class="fas fa-user-injured"></i> Student Health</button>
    <button class="nav-link" data-tab="staffhealth" onclick="switchTab('staffhealth')"><i class="fas fa-user-md"></i> Staff Health</button>
    <button class="nav-link" data-tab="register" onclick="switchTab('register')"><i class="fas fa-book-medical"></i> Clinic Register</button>
    <button class="nav-link" data-tab="newvisit" onclick="switchTab('newvisit')"><i class="fas fa-plus-circle"></i> New Visit</button>
    <button class="nav-link" data-tab="firstaid" onclick="switchTab('firstaid')"><i class="fas fa-band-aid"></i> First Aid</button>
    <button class="nav-link" data-tab="medication" onclick="switchTab('medication')"><i class="fas fa-pills"></i> Medication</button>
    <button class="nav-link" data-tab="inventory" onclick="switchTab('inventory')"><i class="fas fa-boxes"></i> Inventory</button>
    <button class="nav-link" data-tab="referrals" onclick="switchTab('referrals')"><i class="fas fa-ambulance"></i> Referrals</button>
    <button class="nav-link" data-tab="followups" onclick="switchTab('followups')"><i class="fas fa-calendar-check"></i> Follow-ups</button>
    <button class="nav-link" data-tab="screening" onclick="switchTab('screening')"><i class="fas fa-stethoscope"></i> Screening</button>
    <button class="nav-link" data-tab="campaigns" onclick="switchTab('campaigns')"><i class="fas fa-bullhorn"></i> Campaigns</button>
    <button class="nav-link" data-tab="incidents" onclick="switchTab('incidents')"><i class="fas fa-exclamation-triangle"></i> Incidents</button>
    <button class="nav-link" data-tab="parentnotif" onclick="switchTab('parentnotif')"><i class="fas fa-bell"></i> Notify Parent</button>
    <button class="nav-link" data-tab="reports" onclick="switchTab('reports')"><i class="fas fa-file-medical"></i> Reports</button>
    <button class="nav-link" data-tab="handover" onclick="switchTab('handover')"><i class="fas fa-exchange-alt"></i> Handover</button>
    <button class="nav-link" data-tab="notifications" onclick="switchTab('notifications')"><i class="fas fa-bell"></i> Alerts <span id="notifBadge" style="display:none;background:var(--health);color:#fff;border-radius:10px;padding:1px 6px;font-size:10px;margin-left:4px">0</span></button>
    <button class="nav-link" data-tab="emergency" onclick="switchTab('emergency')" style="color:var(--danger)"><i class="fas fa-heartbeat"></i> Emergency</button>
    <button class="nav-link" data-tab="profile" onclick="switchTab('profile')"><i class="fas fa-user"></i> Profile</button>
    <div class="nav-user">
      <div class="user-avatar" id="navUserAvatar">N</div>
      <div class="user-info">
        <div class="user-name" id="navUserName">Loading…</div>
        <div class="user-role" id="navUserRole">Nurse</div>
      </div>
    </div>
    <button class="btn btn-secondary btn-sm" onclick="appLogout()" style="padding:8px 14px;font-size:12px"><i class="fas fa-sign-out-alt"></i> Logout</button>
  </div>
</nav>

<div class="bottom-nav" id="bottomNav">
  <button class="bn-item active" data-tab="dashboard" onclick="switchTab('dashboard')"><i class="fas fa-home"></i><span>Home</span></button>
  <button class="bn-item" data-tab="newvisit" onclick="switchTab('newvisit')"><i class="fas fa-plus-circle"></i><span>New Visit</span></button>
  <button class="bn-item" data-tab="register" onclick="switchTab('register')"><i class="fas fa-book-medical"></i><span>Register</span></button>
  <button class="bn-item" data-tab="medication" onclick="switchTab('medication')"><i class="fas fa-pills"></i><span>Meds</span></button>
  <button class="bn-item" data-tab="emergency" onclick="switchTab('emergency')" style="color:var(--danger)"><i class="fas fa-heartbeat"></i><span>SOS</span></button>
</div>

<div class="container">
  <div class="privacy-banner">
    <i class="fas fa-lock"></i>
