function renderInventory(){
  var body = document.getElementById('inventoryBody');
  if(inventoryCache.length === 0){ body.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#999;padding:20px">No inventory yet.</td></tr>'; populateInvUseSelect(); return; }
  var todayStr = today();
  var low=0, expiring=0, expired=0;
  body.innerHTML = inventoryCache.map(function(i){
    var qty = parseFloat(i.quantity)||0;
    var min = parseFloat(i.minimumLevel)||0;
    var exp = i.expiryDate;
    var status = '';
    if(qty <= 0) status = '<span class="badge badge-missed">OUT</span>';
    else if(exp && exp < todayStr) status = '<span class="badge badge-missed">EXPIRED</span>';
    else if(exp && daysUntil(exp) <= 30) status = '<span class="badge badge-warning">EXPIRING</span>';
    else if(qty <= min) status = '<span class="badge badge-warning">LOW</span>';
    else status = '<span class="badge badge-active">OK</span>';
    if(qty <= min && qty > 0) low++;
    if(exp && exp < todayStr) expired++;
    else if(exp && daysUntil(exp) <= 30) expiring++;
    return '<tr data-search="'+escapeHtml((i.name||'').toLowerCase())+'"><td>'+escapeHtml(i.name||'')+'</td><td>'+qty+'</td><td>'+min+'</td><td>'+escapeHtml(exp||'—')+'</td><td>'+escapeHtml(i.storage||'')+'</td><td>'+status+'</td></tr>';
  }).join('');
  document.getElementById('invTotal').textContent = inventoryCache.length;
  document.getElementById('invLow').textContent = low;
  document.getElementById('invExpiring').textContent = expiring;
  document.getElementById('invExpired').textContent = expired;
  populateInvUseSelect();
}
function daysUntil(dateStr){
  try{
    var d = new Date(dateStr); var n = new Date();
    return Math.ceil((d-n)/(86400000));
  } catch(e){ return 999; }
}
function filterInventory(){
  var q = document.getElementById('invSearch').value.toLowerCase();
  document.querySelectorAll('#inventoryBody tr').forEach(function(tr){
    var s = tr.getAttribute('data-search')||'';
    tr.style.display = (!q || s.indexOf(q)!==-1)?'':'none';
  });
}
function populateInvUseSelect(){
  var sel = document.getElementById('invUseItem');
  sel.innerHTML = '<option value="">Select…</option>' + inventoryCache.map(function(i){
    return '<option value="'+escapeHtml(i.id)+'">'+escapeHtml(i.name)+' ('+(i.quantity||0)+')</option>';
  }).join('');
}
